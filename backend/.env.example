# ==========================================
# GridPilot Backend (Member B) Configuration
# ==========================================

# Server Port
PORT=5000

# Environment: development, test, production
NODE_ENV=development

# Frontend CORS Origin
FRONTEND_ORIGIN=http://localhost:5173

# MongoDB Connection String (Atlas or Local)
MONGODB_URI=mongodb://127.0.0.1:27017/gridpilot

# JWT Authentication
JWT_SECRET=super_secret_gridpilot_jwt_signing_key_2026_change_in_prod
JWT_EXPIRES_IN=24h

# Python Optimization & Simulation Engine Microservice URL
ENGINE_BASE_URL=http://localhost:8000

# Mock Engine Mode: set to true to run backend autonomously when Python engine is offline
USE_MOCK_ENGINE=true

# Orchestrator Tick Interval in Milliseconds (default: 5000ms = 5s)
ORCHESTRATOR_TICK_MS=5000
ORCHESTRATOR_AUTO_START=true

# LLM Grounded Explainability (Claude or OpenAI)
LLM_PROVIDER=claude
LLM_API_KEY=sk-ant-sample-key-or-leave-blank-for-grounded-fallback
