# ==========================================
# GridPilot Backend (Member B) Configuration
# ==========================================

# Server Host & Port (0.0.0.0 binds to all interfaces in container / cloud)
HOST=0.0.0.0
PORT=5000

# Environment: development, test, production
NODE_ENV=development

# Frontend CORS Origin (Use '*' for all, or comma-separated list e.g. https://my-frontend.vercel.app)
FRONTEND_ORIGIN=*

# MongoDB Connection String (MongoDB Atlas URI or local mongodb://127.0.0.1:27017/gridpilot)
MONGODB_URI=mongodb://127.0.0.1:27017/gridpilot

# JWT Authentication Secret & Expiration
JWT_SECRET=super_secret_gridpilot_jwt_signing_key_2026_change_in_prod
JWT_EXPIRES_IN=24h

# Python FastAPI Optimization & Simulation Engine Microservice URL
# (Use https://<your-deployed-engine-domain> in production or http://localhost:8000 locally)
ENGINE_BASE_URL=http://localhost:8000

# Mock Engine Mode: set to false when live Python FastAPI engine is running;
# set to true for offline deterministic simulation.
USE_MOCK_ENGINE=false

# Orchestrator Tick Interval in Milliseconds (5000ms = 5s)
ORCHESTRATOR_TICK_MS=5000
ORCHESTRATOR_AUTO_START=true

# LLM Grounded Explainability (Claude / OpenAI / fallback)
LLM_PROVIDER=claude
LLM_API_KEY=
